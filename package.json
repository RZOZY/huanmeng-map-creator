{
  "name": "huanmeng-map-creator",
  "productName": "HuanMeng Map Creator",
  "version": "0.7.3",
  "description": "HuanMeng Map Creator —— 基于 Azgaar's Fantasy Map Generator (MIT) 二次开发的中文奇幻地图生成器",
  "homepage": "https://github.com/RZOZY/humeng-map-generator#readme",
  "bugs": {
    "url": "https://github.com/RZOZY/humeng-map-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RZOZY/humeng-map-generator.git"
  },
  "license": "MIT",
  "author": "RZOZY",
  "credits": {
    "engine": "Azgaar's Fantasy Map Generator (MIT) — https://github.com/Azgaar/Fantasy-Map-Generator",
    "chineseTemplates": "幻艺地图 fantcraft.com — 中文语料、界面措辞与中文命名模板取材于此（仅供个人学习与研究）",
    "art": "第三方图标素材（Watabou 等），原始署名保留在图标文件的 <desc> 中"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/pwa-precache.mjs",
    "preview": "vite preview",
    "electron": "node scripts/electron.mjs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "biome check --write",
    "sync-version": "node scripts/sync-version.js",
    "stamp-assets": "node scripts/stamp-assets.js",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && node scripts/sync-version.js --stage && node scripts/stamp-assets.js --stage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.57.0",
    "@types/d3": "^7.4.3",
    "@types/delaunator": "^5.0.3",
    "@types/lineclip": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/polylabel": "^1.1.3",
    "@types/three": "^0.184.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "d3": "^7.9.0",
    "delaunator": "^5.0.1",
    "driver.js": "^1.4.0",
    "lineclip": "^2.0.0",
    "polylabel": "^2.0.1",
    "quill": "^2.0.3",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
